# =============================================================================
# CODkar — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# Every variable marked REQUIRED is validated at boot by apps/api/src/config —
# the process exits rather than starting in a half-configured state.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public HTTPS origin of the app. Must match `application_url` in shopify.app.toml.
APP_URL=https://your-tunnel.trycloudflare.com
# Origin the embedded admin SPA is served from. In dev this is the Vite server.
ADMIN_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Shopify — REQUIRED
# From the Partner Dashboard, or written by `shopify app config link`.
# SHOPIFY_API_KEY must equal `client_id` in shopify.app.toml.
# -----------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated. Must match `access_scopes.scopes` in shopify.app.toml exactly,
# or managed installation will loop asking the merchant to re-consent.
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,write_orders,write_draft_orders,read_customers,write_customers,read_customer_events,write_pixels,read_locales,read_markets,read_themes
# Admin API version. Keep in sync with SHOPIFY_API_VERSION in packages/shared.
SHOPIFY_API_VERSION=2026-07

# -----------------------------------------------------------------------------
# Shopify Partner API — REQUIRED for billing (Phase 9)
# Managed App Pricing keeps plan state in Shopify, not in the app. Plan lookups
# go through the Partner API, which needs its own token and your numeric IDs.
# Partner Dashboard -> Settings -> Partner API clients.
# -----------------------------------------------------------------------------
# Must match `handle` in shopify.app.toml. Builds the managed-pricing URL the
# upgrade button opens; a wrong value 404s on Shopify's side.
SHOPIFY_APP_HANDLE=codflow

SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_ORGANIZATION_ID=
# Numeric app id (not the client_id/api key).
SHOPIFY_APP_ID=

# -----------------------------------------------------------------------------
# Database — REQUIRED
# DIRECT_DATABASE_URL bypasses a connection pooler for migrations. When you are
# not behind PgBouncer/Neon/Supabase pooling, set it to the same value.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://codflow:codflow@localhost:5432/codflow?schema=public
DIRECT_DATABASE_URL=postgresql://codflow:codflow@localhost:5432/codflow?schema=public

# -----------------------------------------------------------------------------
# Redis — REQUIRED. Backs BullMQ, response caching and distributed rate limits.
# Upstash: use the rediss:// URL. BullMQ needs `family=0` on some Upstash regions.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Namespace prefix so multiple environments can share one Redis instance.
REDIS_PREFIX=codflow:dev

# -----------------------------------------------------------------------------
# Encryption — REQUIRED
# 32-byte key, base64. Encrypts Google refresh tokens, pixel CAPI tokens and OTP
# provider credentials at rest (AES-256-GCM) before they touch Postgres.
# Generate: openssl rand -base64 32
# Rotating this without re-encrypting existing rows makes those secrets unreadable.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=
# Signs storefront session cookies and the short-lived COD form tokens.
# Generate: openssl rand -hex 64
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Google OAuth — Sheets + Drive (Phase 5)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
# Redirect URI must be exactly: ${APP_URL}/api/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-tunnel.trycloudflare.com/api/google/callback

# -----------------------------------------------------------------------------
# Email (Phase 12 notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=CODkar
MAIL_FROM_ADDRESS=noreply@example.com

# -----------------------------------------------------------------------------
# Optional integrations. Leave blank to disable the feature at runtime;
# the app degrades gracefully rather than failing to boot.
# -----------------------------------------------------------------------------
# Cloudinary — merchant logo / form background uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IP intelligence for the fraud engine (VPN / proxy / TOR detection).
# Supported providers: ipqualityscore | ipapi | proxycheck
IP_INTEL_PROVIDER=
IP_INTEL_API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ADMIN=300
# Storefront endpoints are public and unauthenticated — keep this tight.
RATE_LIMIT_MAX_STOREFRONT=30
RATE_LIMIT_MAX_OTP=5

# -----------------------------------------------------------------------------
# Queue tuning
# -----------------------------------------------------------------------------
QUEUE_CONCURRENCY=10
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=5000

# Shops that ignore plan limits, comma-separated myshopify domains.
#
# For the stores you run yourself. A public app bills every merchant who
# installs it, including its author, and your own store hitting the Free tier's
# order ceiling is not a billing event you want. Empty means every shop is
# billed normally — which is the right default, so a deployment that forgets
# this bills you rather than giving the world an enterprise plan.
PLAN_EXEMPT_SHOPS=

# Where the floating support button in the admin sends merchants.
#
# Your own channel, the same for every merchant — build configuration, not a
# per-shop setting. Leave empty and the button does not render at all, which is
# the right behaviour: a support button opening a blank Telegram page is worse
# than no button.
SUPPORT_TELEGRAM_URL=
