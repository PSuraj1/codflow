{
  "name": "@codflow/api",
  "version": "1.0.0",
  "private": true,
  "description": "CodFlow backend \u2014 Express 5 + TypeScript, clean architecture",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/queue/worker.js",
    "worker:dev": "tsx watch src/queue/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preflight": "tsx src/scripts/preflight.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "diagnose:theme": "tsx src/scripts/diagnoseTheme.ts"
  },
  "dependencies": {
    "@codflow/shared": "*",
    "@prisma/client": "6.19.3",
    "@shopify/shopify-api": "13.1.0",
    "@shopify/shopify-app-session-storage": "5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "9.0.1",
    "bullmq": "5.81.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "google-auth-library": "10.9.1",
    "googleapis": "173.0.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.9",
    "nanoid": "3.3.16",
    "nodemailer": "9.0.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.0",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
